<!--
  Muto NavigateToPose tree.
  Humble-compatible NavigateToPose tree based on the Nav2 Humble default, with
  conservative recovery actions for the Muto platform.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="1" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="1.0">
          <RecoveryNode number_of_retries="1" name="PlanAndSmoothRecovery">
            <Sequence name="PlanAndSmoothPath">
              <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
              <!--
                Smoothing is optional. POI goals are selected from known-free
                cells, while Humble's generic footprint checker treats unknown
                cost 255 as a collision. Preserve the original NavFn path in
                {path}; overwrite it only when checked smoothing succeeds.
              -->
              <ForceSuccess>
                <SmoothPath
                  unsmoothed_path="{path}"
                  smoothed_path="{path}"
                  smoother_id="savitzky_golay_smoother"
                  max_smoothing_duration="0.5"
                  check_for_collisions="true"/>
              </ForceSuccess>
            </Sequence>
            <Sequence name="RefreshGlobalCostmap">
              <ClearEntireCostmap
                name="ClearGlobalCostmap-PlanFailure"
                service_name="global_costmap/clear_entirely_global_costmap"/>
              <Wait wait_duration="2"/>
            </Sequence>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPathRecovery">
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <Sequence name="RefreshLocalCostmap">
            <ClearEntireCostmap
              name="ClearLocalCostmap-ControlFailure"
              service_name="local_costmap/clear_entirely_local_costmap"/>
            <Wait wait_duration="1"/>
          </Sequence>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <!--
          After the targeted refresh/retry, return planning failure to the
          POI authority so it can suppress this candidate and choose
          another. Never rotate or back up merely because planning failed.
        -->
        <Wait wait_duration="2"/>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
