<?xml version="1.0"?>
<package format="3">
  <name>muto_odometry_bag</name>
  <version>0.1.0</version>
  <description>Source-data recording and deterministic replay for Muto odometry.</description>
  <maintainer email="kailoskeuzhao@todo.todo">kailoskeuzhao</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>muto_hexapod_interfaces_custom</depend>
  <depend>rclcpp</depend>
  <depend>rmw</depend>
  <depend>rosbag2_cpp</depend>
  <depend>rosbag2_storage</depend>
  <depend>rosbag2_transport</depend>
  <depend>rosgraph_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>tf2_publisher</exec_depend>
  <exec_depend>yahboomcar_bringup</exec_depend>
  <exec_depend>yahboomcar_imu</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
