# Natural-language description of the kind of registered object to find.
string prompt

# Return the metadata/name shortlist without visually promoting candidates to
# final matches. The model commander uses this mode so it retains authority for
# stored-image confirmation. False preserves the direct FindObject behavior.
bool shortlist_only

# Optional exact registry IDs to refine. Empty means search the whole registry.
# Non-empty means the server may only return matches from this candidate set,
# normally using the registry's stored JPEGs as a final visual selection tool.
string[] candidate_ids
---
bool success
string message
muto_command_layer/ObjectMatch[] matches
---
uint8 PHASE_REGISTRY_LOOKUP=1
uint8 PHASE_TEXT_SHORTLIST=2
uint8 PHASE_VISUAL_REFINEMENT=3
uint8 PHASE_PUBLISHING=4

uint8 phase
string status
uint32 candidate_count
