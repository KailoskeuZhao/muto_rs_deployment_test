# Untrusted natural-language instruction to interpret as one mission.
string query
---
bool success
string message

# Backward-compatible dispatch command plus canonical mission-spec JSON.
string command
string arguments_json

# Exact registry IDs returned by find_object or resolved for go_to_object.
string[] object_ids
---
uint8 PHASE_INTERPRETING=1
uint8 PHASE_RESOLVING_OBJECT=2
uint8 PHASE_DISPATCHING=3
uint8 PHASE_CANCELING=4

uint8 phase
string status
string command
