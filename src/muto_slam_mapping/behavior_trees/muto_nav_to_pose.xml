<!--
  Muto NavigateToPose tree.
  Humble-compatible NavigateToPose tree based on the Nav2 Humble default, with
  conservative recovery actions for the Muto platform.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="2" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="1.0">
          <Sequence name="PlanAndSmoothPath">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
            <SmoothPath
              unsmoothed_path="{path}"
              smoothed_path="{smoothed_path}"
              smoother_id="savitzky_golay_smoother"
              max_smoothing_duration="0.5"
              check_for_collisions="true"/>
          </Sequence>
        </RateController>
        <FollowPath path="{smoothed_path}" controller_id="FollowPath"/>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <!--
          A trapped hexapod must not spin its legs through nearby furniture or
          back up blindly.  Pause once so freshly marked obstacles can trigger
          a replan; if the retry still fails, return failure to the owning
          action instead of issuing an autonomous moving recovery.
        -->
        <Wait wait_duration="2.0"/>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
