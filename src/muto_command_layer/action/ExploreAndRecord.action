# Zero-valued durations and step count use the node's configured defaults.
float32 exploration_duration
float32 observation_duration

# The full 360-degree scan is divided into this many equal spin-and-observe steps.
uint32 scan_step_count

# Zero continues through post-frontier visibility coverage or cancellation.
# A nonzero value completes before post-frontier coverage at that cycle count.
uint32 max_cycles
---
bool success
string message
uint32 completed_cycles
uint32 objects_before
uint32 objects_after
---
uint8 PHASE_EXPLORING=1
uint8 PHASE_PAUSING=2
uint8 PHASE_SPINNING=3
uint8 PHASE_OBSERVING=4
uint8 PHASE_SAVING=5
uint8 PHASE_COVERING=6

uint8 phase
string status
uint32 completed_cycles
uint32 object_count
